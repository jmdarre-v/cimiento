{
  "name": "cimiento",
  "version": "0.1.0",
  "description": "One command from nothing to a deployed, wired, verified project skeleton.",
  "license": "MIT",
  "bin": {
    "cimiento": "dist/cli.js",
    "cim": "dist/cli.js"
  },
  "main": "dist/index.js",
